
pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                echo 'Getting Python project code'
            }
        }

        stage('Build') {
            steps {
                echo 'Building Python application'
                bat 'python --version'
            }
        }

        stage('Test') {
            steps {
                echo 'Running Python tests'
                bat 'python -m unittest apptest'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying Python application'
                bat 'python app.py'
            }
        }
    }

    post {
        success {
            echo 'CI/CD Pipeline Successful!'
        }

        failure {
            echo 'CI/CD Pipeline Failed!'
        }
    }
}
